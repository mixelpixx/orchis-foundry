{
  "openapi": "3.1.0",
  "info": {
    "title": "Orchis Foundry API",
    "version": "0.7.0",
    "description": "Self-hosted code platform: git hosting, pull requests, per-user BYO-model supply-chain scanning, and LLM-friendly context endpoints. Authenticate with a personal access token: `Authorization: Bearer orc_pat_<...>`."
  },
  "servers": [{ "url": "/v1" }],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "orc_pat" }
    }
  },
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/me": { "get": { "summary": "Current user", "responses": { "200": { "description": "User" }, "401": { "description": "Not signed in" } } } },
    "/me/tokens": {
      "get": { "summary": "List personal access tokens", "responses": { "200": { "description": "[Token]" } } },
      "post": { "summary": "Create a token (secret returned once)", "responses": { "200": { "description": "TokenCreated" } } }
    },
    "/me/tokens/{id}/rotate": { "post": { "summary": "Rotate a token", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "TokenCreated" } } } },
    "/me/tokens/{id}": { "delete": { "summary": "Revoke a token", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "204": { "description": "Deleted" } } } },
    "/me/ssh-keys": {
      "get": { "summary": "List SSH keys", "responses": { "200": { "description": "[SSHKey]" } } },
      "post": { "summary": "Add an SSH key", "responses": { "200": { "description": "SSHKey" } } }
    },
    "/me/ssh-keys/{id}": { "delete": { "summary": "Remove an SSH key", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "204": { "description": "Deleted" } } } },
    "/me/pinned": { "get": { "summary": "Repos you've pinned (sidebar order)", "responses": { "200": { "description": "[Repo]" } } } },
    "/me/pinned/{org}/{name}": {
      "put": { "summary": "Pin a repo to your sidebar", "responses": { "204": { "description": "Pinned" } } },
      "delete": { "summary": "Unpin a repo", "responses": { "204": { "description": "Unpinned" } } }
    },
    "/me/stars/{org}/{name}": {
      "put": { "summary": "Star a repo", "responses": { "204": { "description": "Starred" } } },
      "delete": { "summary": "Unstar a repo", "responses": { "204": { "description": "Unstarred" } } }
    },
    "/me/scanner": {
      "get": { "summary": "Get scanner / model config (key masked)", "responses": { "200": { "description": "ScannerSettings" } } },
      "put": { "summary": "Update scanner / model config", "responses": { "200": { "description": "ScannerSettings" } } }
    },
    "/me/webhooks": { "get": { "summary": "List webhooks across repos you own (flat)", "responses": { "200": { "description": "[WebhookSummary]" } } } },
    "/repos/{org}/{name}/webhooks": {
      "get": { "summary": "List a repo's webhooks (owner only)", "responses": { "200": { "description": "[Webhook]" } } },
      "post": { "summary": "Create a webhook", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "url": { "type": "string" }, "events": { "type": "array", "items": { "type": "string", "enum": ["push", "pull_request", "issue", "release", "deploy", "comment"] } }, "secret": { "type": "string" } }, "required": ["url", "events"] } } } }, "responses": { "200": { "description": "Webhook" } } }
    },
    "/repos/{org}/{name}/webhooks/{id}": {
      "patch": { "summary": "Update a webhook (url/events/secret/active)", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Webhook" } } },
      "delete": { "summary": "Delete a webhook", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "204": { "description": "Deleted" } } }
    },
    "/repos/{org}/{name}/webhooks/{id}/test": { "post": { "summary": "Send a test ping delivery", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "204": { "description": "Queued" } } } },
    "/repos": {
      "get": { "summary": "List repos visible to you", "responses": { "200": { "description": "[Repo]" } } },
      "post": { "summary": "Create a repo (bare git repo on disk)", "responses": { "200": { "description": "Repo" } } }
    },
    "/repos/{org}/{name}": {
      "get": { "summary": "Get a repo", "responses": { "200": { "description": "Repo" } } },
      "patch": { "summary": "Update repo settings (rename / description / visibility / default branch)", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "name": { "type": "string" }, "description": { "type": "string" }, "visibility": { "type": "string", "enum": ["public", "private", "internal"] }, "defaultBranch": { "type": "string" } } } } } }, "responses": { "200": { "description": "Repo" } } },
      "delete": { "summary": "Delete a repo", "responses": { "204": { "description": "Deleted" } } }
    },
    "/repos/{org}/{name}/tags": { "get": { "summary": "List tags", "responses": { "200": { "description": "[Tag]" } } } },
    "/repos/{org}/{name}/collaborators": { "get": { "summary": "List collaborators (handle, role)", "responses": { "200": { "description": "[{handle,name,role}]" } } } },
    "/repos/{org}/{name}/collaborators/{handle}": {
      "put": { "summary": "Add/update a collaborator (admin only)", "parameters": [{ "name": "handle", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "role": { "type": "string", "enum": ["read", "write", "admin"] } }, "required": ["role"] } } } }, "responses": { "200": { "description": "{handle,role}" } } },
      "delete": { "summary": "Remove a collaborator (admin only)", "parameters": [{ "name": "handle", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "204": { "description": "Removed" } } }
    },
    "/repos/{org}/{name}/releases": {
      "get": { "summary": "List releases", "responses": { "200": { "description": "[Release]" } } },
      "post": { "summary": "Publish a release (owner only; creates the tag if missing)", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "tag": { "type": "string" }, "name": { "type": "string" }, "body": { "type": "string" }, "target": { "type": "string" }, "prerelease": { "type": "boolean" } }, "required": ["tag"] } } } }, "responses": { "200": { "description": "Release" } } }
    },
    "/repos/{org}/{name}/releases/{tag}": { "delete": { "summary": "Delete a release + its tag (owner only)", "parameters": [{ "name": "tag", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "204": { "description": "Deleted" } } } },
    "/repos/{org}/{name}/releases/{tag}/tarball": { "get": { "summary": "Download release source as .tar.gz", "parameters": [{ "name": "tag", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "application/gzip" } } } },
    "/repos/{org}/{name}/tree": { "get": { "summary": "File tree (nested)", "parameters": [{ "name": "ref", "in": "query", "schema": { "type": "string" } }], "responses": { "200": { "description": "[Node]" } } } },
    "/repos/{org}/{name}/blob": { "get": { "summary": "File contents", "parameters": [{ "name": "ref", "in": "query", "schema": { "type": "string" } }, { "name": "path", "in": "query", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Blob {content,lang,size,lines}" } } } },
    "/repos/{org}/{name}/raw": { "get": { "summary": "Raw file bytes", "responses": { "200": { "description": "bytes" } } } },
    "/repos/{org}/{name}/readme": { "get": { "summary": "README", "responses": { "200": { "description": "{content,format}" } } } },
    "/repos/{org}/{name}/branches": {
      "get": { "summary": "List branches", "responses": { "200": { "description": "[Branch]" } } },
      "post": { "summary": "Create a branch (owner only)", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "name": { "type": "string" }, "from": { "type": "string" } }, "required": ["name"] } } } }, "responses": { "200": { "description": "[Branch]" } } }
    },
    "/repos/{org}/{name}/branches/{branch}": { "delete": { "summary": "Delete a branch (owner only; not the default)", "parameters": [{ "name": "branch", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "204": { "description": "Deleted" }, "409": { "description": "is default branch" } } } },
    "/repos/{org}/{name}/commits": { "get": { "summary": "List commits", "parameters": [{ "name": "ref", "in": "query", "schema": { "type": "string" } }, { "name": "limit", "in": "query", "schema": { "type": "integer" } }], "responses": { "200": { "description": "[Commit]" } } } },
    "/repos/{org}/{name}/commits/{sha}": { "get": { "summary": "Commit detail + diff", "parameters": [{ "name": "sha", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "{sha,short,message,author,email,date,additions,deletions,files:[FileDiff]}" } } } },
    "/repos/{org}/{name}/compare": { "get": { "summary": "Compare two branches (diff + commits) without a PR", "parameters": [{ "name": "base", "in": "query", "schema": { "type": "string" } }, { "name": "head", "in": "query", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "{base,head,aheadBy,additions,deletions,filesCount,commits,files}" } } } },
    "/repos/{org}/{name}/checks": { "get": { "summary": "Recent check runs across the repo (scan + external CI)", "parameters": [{ "name": "limit", "in": "query", "schema": { "type": "integer" } }], "responses": { "200": { "description": "[Check]" } } } },
    "/repos/{org}/{name}/issues": {
      "get": { "summary": "List issues", "parameters": [{ "name": "state", "in": "query", "schema": { "type": "string", "enum": ["open", "closed", "all"] } }], "responses": { "200": { "description": "[Issue]" } } },
      "post": { "summary": "Open an issue", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "title": { "type": "string" }, "body": { "type": "string" } }, "required": ["title"] } } } }, "responses": { "200": { "description": "Issue" } } }
    },
    "/repos/{org}/{name}/issues/{num}": {
      "get": { "summary": "Issue detail", "responses": { "200": { "description": "Issue" } } },
      "patch": { "summary": "Edit issue (title/body/state/assignee)", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "title": { "type": "string" }, "body": { "type": "string" }, "state": { "type": "string", "enum": ["open", "closed"] }, "assignee": { "type": "string" } } } } } }, "responses": { "200": { "description": "Issue" } } }
    },
    "/repos/{org}/{name}/issues/{num}/comments": {
      "get": { "summary": "Issue comments", "responses": { "200": { "description": "[Comment]" } } },
      "post": { "summary": "Comment on an issue", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "body": { "type": "string" } }, "required": ["body"] } } } }, "responses": { "200": { "description": "Comment" } } }
    },
    "/repos/{org}/{name}/pack": { "get": { "summary": "Whole repo as one markdown document (LLM ingest)", "parameters": [{ "name": "ref", "in": "query", "schema": { "type": "string" } }, { "name": "maxBytes", "in": "query", "schema": { "type": "integer" } }], "responses": { "200": { "description": "text/markdown" } } } },
    "/search/palette": { "get": { "summary": "Command-palette search (repos, PRs, files)", "parameters": [{ "name": "q", "in": "query", "schema": { "type": "string" } }], "responses": { "200": { "description": "{repos:[],pulls:[],files:[]} each item {id,label,sub,route}" } } } },
    "/search/code": { "get": { "summary": "Code search (literal, via git grep)", "parameters": [{ "name": "q", "in": "query", "required": true, "schema": { "type": "string" } }, { "name": "repo", "in": "query", "schema": { "type": "string" } }, { "name": "ref", "in": "query", "schema": { "type": "string" } }, { "name": "lang", "in": "query", "schema": { "type": "string" } }], "responses": { "200": { "description": "[{repo,path,ref,line,text,route}]" } } } },
    "/search/repos": { "get": { "summary": "Repository search", "parameters": [{ "name": "q", "in": "query", "schema": { "type": "string" } }], "responses": { "200": { "description": "[{id,label,sub,route}]" } } } },
    "/search/users": { "get": { "summary": "User search", "parameters": [{ "name": "q", "in": "query", "schema": { "type": "string" } }], "responses": { "200": { "description": "[{id,handle,name,initials,color}]" } } } },
    "/stream": { "get": { "summary": "Server-Sent Events stream (realtime)", "description": "Subscribe to ACL'd topics for live events. Cookie auth only (EventSource cannot set headers). Event kinds: pull.commented, pull.reviewed, pull.merged, push, check.updated.", "parameters": [{ "name": "topics", "in": "query", "description": "Comma-separated: pull:org/name#num, repo:org/name, inbox:<userId>", "schema": { "type": "string" } }], "responses": { "200": { "description": "text/event-stream" } } } },
    "/pulls": { "get": { "summary": "Pull requests across your repos", "parameters": [{ "name": "filter", "in": "query", "schema": { "type": "string", "enum": ["review-requested", "yours", "mentioned", "all"] } }], "responses": { "200": { "description": "[PullSummary]" } } } },
    "/repos/{org}/{name}/pulls": {
      "get": { "summary": "List PRs in a repo", "parameters": [{ "name": "state", "in": "query", "schema": { "type": "string", "enum": ["open", "closed", "merged", "all"] } }], "responses": { "200": { "description": "[PullSummary]" } } },
      "post": { "summary": "Open a PR", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "title": { "type": "string" }, "head": { "type": "string" }, "base": { "type": "string" }, "body": { "type": "string" } }, "required": ["title", "head"] } } } }, "responses": { "200": { "description": "PullSummary" } } }
    },
    "/repos/{org}/{name}/pulls/{num}": {
      "get": { "summary": "PR detail", "responses": { "200": { "description": "PullSummary" } } },
      "patch": { "summary": "Edit PR title/body", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "title": { "type": "string" }, "body": { "type": "string" } } } } } }, "responses": { "200": { "description": "PullSummary" } } }
    },
    "/repos/{org}/{name}/pulls/{num}/files": { "get": { "summary": "PR diff (FileDiff[] with line comments)", "responses": { "200": { "description": "[FileDiff]" } } } },
    "/repos/{org}/{name}/pulls/{num}/commits": { "get": { "summary": "PR commits", "responses": { "200": { "description": "[Commit]" } } } },
    "/repos/{org}/{name}/pulls/{num}/comments": {
      "get": { "summary": "PR comments", "responses": { "200": { "description": "[Comment]" } } },
      "post": { "summary": "Post a comment (top-level or line-anchored)", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "body": { "type": "string" }, "path": { "type": "string" }, "line": { "type": "integer" }, "side": { "type": "string", "enum": ["left", "right"] } }, "required": ["body"] } } } }, "responses": { "200": { "description": "Comment" } } }
    },
    "/repos/{org}/{name}/pulls/{num}/reviews": { "post": { "summary": "Submit a review", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "verdict": { "type": "string", "enum": ["comment", "approve", "changes"] }, "body": { "type": "string" } } } } } }, "responses": { "200": { "description": "ok" } } } },
    "/repos/{org}/{name}/pulls/{num}/merge": { "post": { "summary": "Merge a PR", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "strategy": { "type": "string", "enum": ["merge", "squash", "rebase"] }, "commit_title": { "type": "string" }, "commit_body": { "type": "string" } } } } } }, "responses": { "200": { "description": "merged" }, "409": { "description": "conflict / not open" } } } },
    "/repos/{org}/{name}/pulls/{num}/request-review": { "post": { "summary": "Request a review (owner/author only)", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "reviewer": { "type": "string" } }, "required": ["reviewer"] } } } }, "responses": { "200": { "description": "ok" } } } },
    "/repos/{org}/{name}/pulls/{num}/request-review/{handle}": { "delete": { "summary": "Remove a requested reviewer", "parameters": [{ "name": "handle", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "204": { "description": "removed" } } } },
    "/repos/{org}/{name}/pulls/{num}/checks": { "get": { "summary": "Check runs for the PR head (incl. orchis-scan)", "responses": { "200": { "description": "[Check]" } } } },
    "/repos/{org}/{name}/pulls/{num}/scan": { "post": { "summary": "Re-run the supply-chain scan", "responses": { "200": { "description": "queued" } } } },
    "/repos/{org}/{name}/pulls/{num}/pack": { "get": { "summary": "PR as one markdown document (LLM ingest)", "responses": { "200": { "description": "text/markdown" } } } },
    "/repos/{org}/{name}/pulls/{num}/summarize": { "post": { "summary": "Summarize the PR with your configured model", "responses": { "200": { "description": "{summary}" }, "409": { "description": "no model configured" } } } },
    "/repos/{org}/{name}/pulls/{num}/explain": { "post": { "summary": "Explain the diff (optional ?file=) with your model", "parameters": [{ "name": "file", "in": "query", "schema": { "type": "string" } }], "responses": { "200": { "description": "{explanation}" } } } },
    "/repos/{org}/{name}/pulls/{num}/draft-description": { "post": { "summary": "Draft a PR description with your model", "responses": { "200": { "description": "{description}" } } } }
  }
}
